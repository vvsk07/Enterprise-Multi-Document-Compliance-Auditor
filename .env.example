# Application Configuration
APP_NAME="Enterprise-Grade Multi-Document Intelligence & Compliance Auditor"
APP_ENV="development"
DEBUG=True
HOST="127.0.0.1"
PORT=8000

# Security Configuration
AUDITOR_API_KEY="change-me-key-for-development"

# Database Configuration
DATABASE_URL="sqlite:///./data/compliance_auditor.db"

# Storage Paths
UPLOADS_DIR="./data/uploads"
PROCESSED_DIR="./data/processed"
SAMPLE_DOCS_DIR="./data/sample_documents"
CONFIG_DIR="./configs"

# Vector Database & BM25
VECTOR_DB_TYPE="faiss"
VECTOR_INDEX_PATH="./data/processed/faiss_index.bin"
EMBEDDING_MODEL_NAME="sentence-transformers/all-MiniLM-L6-v2"

# LLM Provider Configuration
LLM_PROVIDER="mock"
LLM_API_KEY=""
LLM_MODEL_NAME="gpt-4o-mini"
LLM_BASE_URL=""

# Tesseract OCR Configuration (Windows path)
TESSERACT_CMD="C:\\Program Files\\Tesseract-OCR\\tesseract.exe"
